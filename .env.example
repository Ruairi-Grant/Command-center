# Local development defaults. Copy to your shell environment; do not commit a real .env.
CC_ENV=development
CC_DATA_DIR=/home/your-user/.local/share/command-centre/dev/data
CC_BACKUP_DIR=/home/your-user/.local/share/command-centre/dev/backups
CC_BIND_HOST=127.0.0.1
CC_PORT=8787
# Optional exact hostname used by a private reverse proxy.
CC_ALLOWED_HOSTS=
# Set both values together when identity verification is intentionally enabled.
CC_REQUIRE_TS_IDENTITY=false
CC_EXPECTED_TS_LOGIN=
# Optional launcher log path.
CC_LOG_FILE=
