# Operational data — portable and human-readable by design, but NOT
# versioned. Committing personal records would put them permanently in
# git history, and backups/ is high-churn snapshot data.
data/
backups/

# Runtime dashboard logs (regenerated; never versioned)
logs/

# Cross-process advisory lock files (runtime state, not source)
.cc.lock
.cc.lock.backups

# Python
__pycache__/
*.pyc

# Temp files written next to data during atomic writes
*.tmp-*
.tmp-*

# Development environments and generated reports
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Container and editor-local files
compose.override.yaml
docker-compose.override.yml
.vscode/
